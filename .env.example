# Resend API key with "Full access" permission (a sending-only key cannot create contacts).
RESEND_API_KEY=
# Id of the Resend segment (formerly "audience") that collects waitlist signups.
RESEND_AUDIENCE_ID=
# Optional. Sender for the signup confirmation, in the form: Burly <name@your-domain>. Empty turns confirmations off.
WAITLIST_FROM=
# Optional. Reply-to address for the signup confirmation.
WAITLIST_REPLY_TO=
